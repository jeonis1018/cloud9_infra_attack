# ─────────────────────────────────────────────────────────────
# scenario3 (OS 커맨드 인젝션 -> 호스트 셸 -> 지속성 -> 파일 변형)
#   cp .env.example .env  후 값 채우기.  .env 는 .gitignore 처리됨.
#   값은 비워둔 채 커밋한다. 실제 값은 .env 에만 넣는다.
#   `KEY=` (빈 값)은 '미설정'으로 취급되어 코드 기본값이 쓰인다.
# ─────────────────────────────────────────────────────────────


# =============================================================
# 공격
# =============================================================

# [필수] 웹앱 정상 로그인 계정 (scenario3은 정상 로그인 후 OS 커맨드 인젝션이 초점)
WHS_LOGIN_EMAIL=
WHS_LOGIN_PASSWORD=

# 대상 웹앱
WEBAPP_URL=https://whs4namu.click

# 단일 대상 정책: 로그인 직후 인스턴스 1대를 고정하고 1~4 전부 그 한 대에서만 실행한다.
#   → 설정할 값 없음. 잡힌 호스트는 로그의 [pin] 줄과 recovery/*.json 에 남는다.

# 2. 노출 SSH 시도 대상. private subnet 이라 실제 연결은 안 되고 REJECT/timeout 만 남긴다.
#   반드시 '고정된 대상이 아닌 쪽' 인스턴스의 private IP 를 넣는다.
#   비워두면 127.0.0.1 로 가는데, 루프백이라 ENI 를 안 타서 Flow Log 에 아무것도 안 남는다.
SSH_PROBE_TARGET=

# 3. 지속성 마커. 비워두면 코드 기본값('# whs-lab-scenario3-marker', 26자) 사용.
#   ~/.bashrc 에 추가되는 주석 마커일 뿐, 실제 페이로드가 아니다.
#   길이 주의: 마커가 명령에 두 번 들어가고, 여기에 대상 고정 가드(78자)까지 붙어서
#   os-command 200자 한도를 공유한다. 32자를 넘기면 중단된다(기본값 26자).
PERSIST_MARKER=


# -------------------------------------------------------------
# 복구 전용  (python scenario3.py --restore)
#
#   여기 값은 공격 단계에서 절대 쓰지 않는다. 실습 운영자 계정을 넣는다.
#
#   되돌리는 것
#     - 4단계 변형(restore.sh) + 잔여물(.bak / restore.sh / NOTE.txt)
#     - 3단계 ~/.bashrc 마커
#       → 위 둘은 웹앱 RCE 경로로 처리한다. AWS 자격증명이 필요 없다.
#     - 4단계에서 올린 impact.sh (S3)
#       → 이것만 운영자 자격증명이 필요하다. 공격 경로로는 못 지운다
#         (EC2 역할에도 공격용 키에도 s3:DeleteObject 가 없다).
#
#   대상 호스트는 recovery/impact_manifest.json 의 target_host 에서 읽고,
#   없으면 recovery/persistence_marker.json 으로 폴백한다. 새로 고정하지 않는
#   이유는 ALB 가 다른 인스턴스를 주면 공격한 곳이 아닌 데서 복구하게 되기 때문이다.
#
#   필요 권한: s3:DeleteObject (업로드 버킷)
#   비워두면 호스트만 되돌리고 S3 객체는 수동 정리하라고 안내한다.
# -------------------------------------------------------------

UPLOAD_BUCKET=whs-cloud9-vuln-web-lab-896986966760-ap-northeast-2-an

RESTORE_AWS_ACCESS_KEY_ID=
RESTORE_AWS_SECRET_ACCESS_KEY=
RESTORE_AWS_REGION=ap-northeast-2
