# ─────────────────────────────────────────────────────────────
# scenario1 (SSRF -> 자격증명 -> S3 유출 -> GuardDuty 무력화 -> SSE-C 랜섬)
#   cp .env.example .env  후 값 채우기.  .env 는 .gitignore 처리됨.
#   값은 비워둔 채 커밋한다. 실제 값은 .env 에만 넣는다.
#   `KEY=` (빈 값)은 '미설정'으로 취급되어 코드 기본값이 쓰인다.
# ─────────────────────────────────────────────────────────────


# =============================================================
# 공격
# =============================================================

# [필수] 웹앱 정상 로그인 계정 (scenario1은 SSRF가 초점이라 로그인은 정상 계정)
WHS_LOGIN_EMAIL=
WHS_LOGIN_PASSWORD=

# 대상 웹앱. 리전은 IMDS instance-identity 문서에서 읽으므로 설정 불필요.
WEBAPP_URL=https://whs4namu.click

# [필수] 유출/랜섬 대상 버킷과 prefix (앱 업로드 영역 whs-uploads/ 와 분리된 데이터 영역)
DATA_BUCKET=whs-cloud9-vuln-web-lab-896986966760-ap-northeast-2-an
DATA_PREFIX=whs-data/

# 5. 탈취한 것으로 치는 장기 자격증명 (IAM User). 6·7 이 이 키로 실행된다.
#   S3 의 config.json 에는 가상의 값만 들어 있다 — 유출 성공을 '장기키 탈취'로 치고
#   실제 호출에 쓰는 키는 여기서 읽는다. 진짜 키를 S3 객체로 두지 않기 위해서다.
#   비워두면 6·7 이 2단계의 임시키(역할 권한)로 돌아 대부분 Deny 된다.
PERSIST_AWS_ACCESS_KEY_ID=
PERSIST_AWS_SECRET_ACCESS_KEY=

# 6. GuardDuty 비활성화에 필요. 기본 실행에 포함되므로 필수.
GUARDDUTY_DETECTOR_ID=2daa4601845647bc8ea3e66f821d8401

# 7. SSE-C 랜섬용 대칭키(32바이트 base64).
#   비워두면 os.urandom(32) 으로 새로 만든다.
#   어느 경우든 키는 scenario1/recovery/ssec.key 에 저장·검증된 뒤에야 재암호화가 시작된다.
#   recovery/ 는 .gitignore 처리됨 — 로컬에는 반드시 남기고 커밋은 하지 않는다.
SSEC_KEY_B64=


# -------------------------------------------------------------
# 복구 전용  (python scenario1.py --restore)
#
#   여기 값은 공격 단계에서 절대 쓰지 않는다.
#   위 PERSIST_AWS_* (탈취당한 것으로 치는 공격자 계정) 와는
#   **다른 IAM User** 를 넣는다. 복구는 공격자가 아니라 실습 운영자의 일이고,
#   CloudTrail 에서도 공격 행위와 뒷정리가 다른 principal 로 구분돼야 한다.
#
#   --restore 는 웹앱을 건드리지 않는다(SSRF·로그인 없음). AWS API 만 호출한다.
#
#   필요 권한: s3:GetObject / s3:PutObject (대상 prefix),
#              s3:PutEncryptionConfiguration (SSE-C 차단 복원),
#              guardduty:UpdateDetector (탐지 재활성화)
# -------------------------------------------------------------

RESTORE_AWS_ACCESS_KEY_ID=
RESTORE_AWS_SECRET_ACCESS_KEY=
RESTORE_AWS_REGION=ap-northeast-2
