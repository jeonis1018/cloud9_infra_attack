# ─────────────────────────────────────────────────────────────
# scenario2 (SQLi 인증우회 -> SSTI/업로드 RCE -> 웹셸 지속성 -> 리소스 하이재킹)
#   cp .env.example .env  후 값 채우기.  .env 는 .gitignore 처리됨.
#   값은 비워둔 채 커밋한다. 실제 값은 .env 에만 넣는다.
#   `KEY=` (빈 값)은 '미설정'으로 취급되어 코드 기본값이 쓰인다.
# ─────────────────────────────────────────────────────────────


# =============================================================
# 공격
# =============================================================

# 대상 웹앱
WEBAPP_URL=https://whs4namu.click

# 1. SQLi 인증우회 페이로드. 비워두면 코드 기본값(' OR '1'='1' -- ) 사용.
#   scenario2는 로그인 계정이 필요 없다(우회가 시연 포인트).
SQLI_PAYLOAD=

# 단일 대상 정책: 로그인 직후 인스턴스 1대를 고정하고 2~5 전부 그 한 대에서만 실행한다.
#   ALB 는 라운드로빈에 고정 세션도 꺼져 있어서, 대상이 아닌 인스턴스에 걸리면
#   페이로드 안의 가드가 아무것도 하지 않고 빠지고 코드가 재시도한다.
#   → 설정할 값 없음. 어느 인스턴스가 잡혔는지는 로그와 recovery/*.json 에 남는다.

# 3. 웹셸 마커 문자열. 비워두면 'whs-scenario2-webshell'.
PERSIST_MARKER=

# 5. 리소스 하이재킹(마이닝) 흉내 설정. 실제 채굴 안 함(DNS+TCP+짧은 CPU 스핀만).
#   주의: 이 호스트는 GuardDuty CryptoCurrency 목록에 있어 파인딩이 실제로 발생한다(의도된 동작).
MINING_POOL_HOST=pool.supportxmr.com
MINING_POOL_PORT=3333

# 채굴 지갑 주소 자리표시자(로그엔 마스킹만). 실제 지갑 넣지 말 것. 비워도 됨.
MINING_WALLET=

# 6. DNS 송신 통제 검증용 도메인 (Route 53 Resolver DNS Firewall).
#   대상 호스트에서 이 이름을 한 번 조회하고 결과만 찍는다. 데이터 전송 없음.
#   DNS Firewall 도메인 목록에 등록한 이름을 넣는다. 내 소유 도메인이어야 한다.
#   비워두면 6단계를 건너뛴다(DNS Firewall 설정 전에도 1~5는 그대로 돌아간다).
#
#   판정은 CloudWatch Logs 의 Resolver 쿼리 로그에서 한다:
#     필드 없음 → 규칙 미적용 /  ALERT → 기록만 /  BLOCK → 차단
DNS_PROBE_DOMAIN=

# 7. 데이터 송신 확인. 더미 파일 1개를 수신 서버로 보내고 결과만 찍는다.
#   비워두면 7단계를 건너뛴다.
#   C2_SRC_FILE 은 /opt/whs-lab-data/ 아래만 허용된다(페이로드에서 거부).
C2_URL=
C2_SRC_FILE=/opt/whs-lab-data/orders.csv


# -------------------------------------------------------------
# 복구 전용  (python scenario2.py --restore)
#
#   여기 값은 공격 단계에서 절대 쓰지 않는다. 실습 운영자 계정을 넣는다.
#   업로드 객체 삭제는 공격 경로로는 불가능하다 — EC2 역할에도
#   공격용 장기키에도 s3:DeleteObject 가 없다.
#
#   필요 권한: s3:DeleteObject (업로드 버킷)
# -------------------------------------------------------------

# --restore 가 업로드 객체를 지울 버킷 (앱이 업로드를 저장하는 곳)
UPLOAD_BUCKET=whs-cloud9-vuln-web-lab-896986966760-ap-northeast-2-an

RESTORE_AWS_ACCESS_KEY_ID=
RESTORE_AWS_SECRET_ACCESS_KEY=
RESTORE_AWS_REGION=ap-northeast-2
